{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["target/release/tolkin", "target/release/tolkin.d"],
      "inputs": ["$TURBO_DEFAULT$", "!target/**"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!target/**"]
    },
    "lint:rust": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!target/**"]
    },
    "test": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!target/**"]
    }
  }
}
